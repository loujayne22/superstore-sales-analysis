    {
      "cell_type": "code",
      "source": [
        "def iqr_bounds(data, col):\n",
        "    Q1, Q3 = data[col].quantile([0.25, 0.75])\n",
        "    IQR = Q3 - Q1\n",
        "    return Q1 - 1.5 * IQR, Q3 + 1.5 * IQR\n",
        "\n",
        "for c in num_cols:\n",
        "    low, high = iqr_bounds(df, c)\n",
        "    n = ((df[c] < low) | (df[c] > high)).sum()\n",
        "    print(f\"{c}: bounds [{low:.2f}, {high:.2f}] -> {n} outlier(s)\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "iRgFQ1-bs19M",
        "outputId": "f37ad5f1-da7c-4e5d-85d3-c190669e88df"
      },
      "execution_count": 27,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Culmen Length (mm): bounds [25.44, 62.34] -> 0 outlier(s)\n",
            "Culmen Depth (mm): bounds [10.95, 23.35] -> 0 outlier(s)\n",
            "Flipper Length (mm): bounds [155.50, 247.50] -> 0 outlier(s)\n",
            "Body Mass (g): bounds [1750.00, 6550.00] -> 0 outlier(s)\n",
            "Delta 15 N (o/oo): bounds [7.06, 10.38] -> 0 outlier(s)\n",
            "Delta 13 C (o/oo): bounds [-28.08, -23.30] -> 0 outlier(s)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "mask = pd.Series(True, index=df.index)\n",
        "for c in num_cols:\n",
        "    low, high = iqr_bounds(df, c)\n",
        "    mask &= df[c].between(low, high)\n",
        "\n",
        "print(\"Rows that would be removed:\", (~mask).sum())\n",
        "\n",
        "df_clean = df[mask].copy()\n",
        "print(df.shape, \"->\", df_clean.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "VmZK7VBPtfG7",
        "outputId": "17c4ea43-98ee-428d-fc5c-98e723e26134"
      },
