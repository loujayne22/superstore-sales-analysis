        "            \"Body Mass (g)\", \"Delta 15 N (o/oo)\", \"Delta 13 C (o/oo)\"]\n",
        "\n",
        "for c in num_cols:\n",
        "    df[c] = df[c].fillna(df[c].median())"
      ],
